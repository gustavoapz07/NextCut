# Copia este archivo como .env.local y llena los valores. Nunca subas .env.local al repositorio.
# Todas estas variables son públicas por diseño: terminan dentro del JavaScript del navegador.

# Supabase (con `npx supabase start`, la URL local es http://127.0.0.1:54321)
VITE_SUPABASE_URL=
# Clave publicable (sb_publishable_…), protegida por RLS. Nunca la clave secreta (sb_secret_…).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (clave del sitio, no la secreta)
VITE_TURNSTILE_SITE_KEY=

# Web Push (clave pública VAPID)
VITE_VAPID_PUBLIC_KEY=

# Sentry (DSN del proyecto de frontend)
VITE_SENTRY_DSN=

# Los secretos (TURNSTILE_SECRET, VAPID_PRIVATE_KEY, SMTP de Resend) van solo en los secretos
# de Supabase: npx supabase secrets set NOMBRE=valor
