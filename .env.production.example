# Plantilla de las variables de producción. Cópiala como .env.production.local (no se sube al
# repositorio) y llénala con los valores del proyecto de producción. Guía: docs/produccion.md.
#
# Todas son públicas: terminan dentro del JavaScript del navegador. Los secretos van solo en
# Supabase (npx supabase secrets set …).
#
# `npm run deploy:produccion` revisa estas variables antes de armar el build y frena si alguna
# falta o quedó con el valor de pruebas de .env.local (scripts/revisar-produccion.mjs).

# Proyecto de producción de Supabase (Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Widget real de Turnstile (Cloudflare → Turnstile). No sirve la clave de prueba 1x000…AA.
VITE_TURNSTILE_SITE_KEY=

# Clave pública VAPID del proyecto de producción (node scripts/claves-vapid.mjs <project-ref>)
VITE_VAPID_PUBLIC_KEY=

# Opcional: correo o WhatsApp que aparece en /privacidad para pedir que se borren los datos
VITE_CONTACTO_PRIVACIDAD=

# Opcional: DSN del proyecto de React en Sentry
VITE_SENTRY_DSN=
