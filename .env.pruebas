# Publicación de prueba en Cloudflare Workers (npm run deploy:pruebas), contra el proyecto de
# Supabase de pruebas. Solo valores públicos: la URL y la clave publicable salen de .env.local.
# Clave de sitio de prueba de Cloudflare: siempre pasa. El proyecto de pruebas usa la secreta de
# prueba, así que no baja la protección que ya había. En producción va la clave real del widget.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
