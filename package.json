{
  "name": "nextcut",
  "version": "0.0.0",
  "private": true,
  "description": "Fila virtual para barberías que atienden por orden de llegada",
  "author": "Gustavo Pérez",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "supabase": "supabase",
    "deploy": "npm run build && wrangler deploy",
    "test:concurrencia": "node scripts/concurrencia.mjs"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "lefthook@2.2.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
