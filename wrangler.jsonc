// Hosting de la PWA en Cloudflare Workers como recursos estáticos (ADR-005).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nextcut",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    // Cualquier ruta sin archivo devuelve index.html y la resuelve React Router.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "send_metrics": false
}
