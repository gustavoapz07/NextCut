// Hosting de la PWA en Cloudflare Workers como recursos estáticos (ADR-005).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nextcut",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    // Cualquier ruta sin archivo devuelve index.html y la resuelve React Router.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "send_metrics": false,
  // El Worker de arriba (`nextcut`) es la versión de pruebas. Producción es otro Worker, así
  // `npm run deploy:pruebas` nunca la pisa. Se publica con `npm run deploy:produccion`.
  // El dominio propio se agrega en "routes" cuando exista (docs/produccion.md).
  "env": {
    "produccion": {
      "name": "nextcut-produccion",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
